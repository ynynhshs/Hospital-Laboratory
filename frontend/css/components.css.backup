
/* ==========================================
   MEDILINK LABORATORY
   REUSABLE COMPONENTS STYLESHEET
========================================== */

/* 1. Buttons */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
}

.btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.btn-primary {
    background-color: var(--color-primary);
    color: white;
}

.btn-primary:hover:not(:disabled) {
    background-color: var(--color-primary-dark);
}

.btn-secondary {
    background-color: #e9eef2;
    color: var(--color-text);
}

.btn-secondary:hover:not(:disabled) {
    background-color: #dce5eb;
}

.btn-success {
    background-color: var(--color-success);
    color: white;
}

.btn-success:hover:not(:disabled) {
    background-color: #176c49;
}

.btn-danger {
    background-color: var(--color-danger);
    color: white;
}

.btn-danger:hover:not(:disabled) {
    background-color: #a52e23;
}

.btn-outline {
    border-color: var(--color-border);
    background-color: transparent;
    color: var(--color-text);
}

.btn-outline:hover:not(:disabled) {
    background-color: var(--color-background);
}

.btn-small {
    min-height: 32px;
    padding: 6px 11px;
    font-size: 12px;
}

.btn-large {
    min-height: 48px;
    padding: 12px 22px;
    font-size: 15px;
}

.btn-block {
    width: 100%;
}

/* 2. Cards */

.card {
    padding: 22px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-small);
}

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
}

.card-title {
    font-size: 17px;
    font-weight: 600;
}

.card-description {
    margin-top: 4px;
    color: var(--color-text-secondary);
    font-size: 13px;
}

.card-body {
    width: 100%;
}

.card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
}

/* 3. Dashboard Statistic Cards */

.stat-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-small);
}

.stat-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: var(--radius-medium);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 21px;
}

.stat-label {
    color: var(--color-text-secondary);
    font-size: 13px;
}

.stat-value {
    margin-top: 3px;
    font-size: 25px;
    font-weight: 700;
}

/* 4. Form Elements */

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 18px;
}

.form-label {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 600;
}

.required-mark {
    color: var(--color-danger);
}

.form-control {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background-color: white;
    color: var(--color-text);
    font-size: 14px;
}

.form-control:focus {
    border-color: var(--color-primary);
    outline: 2px solid rgba(23, 107, 135, 0.12);
}

.form-control:disabled,
.form-control[readonly] {
    background-color: #f0f3f5;
    cursor: not-allowed;
}

textarea.form-control {
    min-height: 100px;
    resize: vertical;
}

.form-help {
    color: var(--color-text-secondary);
    font-size: 12px;
}

.form-error {
    color: var(--color-danger);
    font-size: 12px;
}

.form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

/* 5. Tables */

.table-container {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background-color: var(--color-surface);
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 13px;
}

.data-table th,
.data-table td {
    padding: 13px 15px;
    border-bottom: 1px solid var(--color-border);
    white-space: nowrap;
}

.data-table th {
    background-color: #f5f8fa;
    color: var(--color-text-secondary);
    font-weight: 700;
}

.data-table tbody tr:hover {
    background-color: #f8fbfc;
}

.data-table tbody tr:last-child td {
    border-bottom: none;
}

/* 6. Status Badges */

.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.badge-pending {
    background-color: #fff3d6;
    color: #946200;
}

.badge-progress {
    background-color: #e4f1ff;
    color: #1b5c99;
}

.badge-completed {
    background-color: #def5e8;
    color: #176c49;
}

.badge-cancelled {
    background-color: #fde8e7;
    color: #a52e23;
}

.badge-warning {
    background-color: #fff0dc;
    color: #995600;
}

.badge-info {
    background-color: #e1f1f7;
    color: #176b87;
}

.badge-neutral {
    background-color: #edf0f2;
    color: #52616b;
}

/* 7. Alerts and Notifications */

.alert {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    padding: 14px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-size: 13px;
}

.alert-success {
    border-color: #bce5cc;
    background-color: #eaf7ef;
    color: #176c49;
}

.alert-warning {
    border-color: #f1d9a9;
    background-color: #fff6e5;
    color: #875b08;
}

.alert-danger {
    border-color: #efc1bd;
    background-color: #fff0ef;
    color: #a52e23;
}

.alert-info {
    border-color: #c5e2ed;
    background-color: #edf7fb;
    color: #176b87;
}

/* 8. Search and Toolbar */

.toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 18px;
}

.search-input {
    width: 100%;
    max-width: 320px;
}

/* 9. Empty State */

.empty-state {
    padding: 40px 20px;
    text-align: center;
}

.empty-state-icon {
    margin-bottom: 12px;
    color: var(--color-text-secondary);
    font-size: 36px;
}

.empty-state-title {
    margin-bottom: 6px;
    font-size: 17px;
}

.empty-state-description {
    color: var(--color-text-secondary);
    font-size: 13px;
}

/* 10. Loading Indicator */

.loading-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    color: var(--color-text-secondary);
    font-size: 14px;
}

/* 11. Pagination */

.pagination {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
}

.pagination button {
    min-width: 34px;
    min-height: 34px;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background-color: white;
    color: var(--color-text);
}

.pagination button.active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: white;
}

.pagination button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* 12. Responsive Components */

@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .card {
        padding: 16px;
    }

    .stat-card {
        padding: 15px;
    }

    .toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .search-input {
        max-width: none;
    }

    .card-footer {
        justify-content: flex-start;
    }
}
