/* 1. Layout Structure */
.app-layout {
    display: flex;
    min-height: 100vh;
    width: 100%;
}

/* 2. Sidebar */

.sidebar {
    position: sticky;
    top: 0;
    align-self: flex-start;
    width: 260px;
    min-width: 260px;
    height: 100vh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-sidebar);
    color: var(--color-text-light);
    transition: transform 0.3s ease;
    z-index: 1000;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 80px;
    padding: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.sidebar-brand h2 {
    color: var(--color-text-light);
    font-size: 20px;
}

.sidebar-brand p {
    color: #c1d4df;
    font-size: 12px;
}

.brand-logo {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: var(--radius-medium);
    background-color: var(--color-accent);
    color: white;
    font-size: 20px;
    font-weight: bold;
}

/* 3. Sidebar Navigation */

.sidebar-nav {
    flex: 1;
    padding: 20px 12px;
    overflow-y: auto;
}

.nav-section-title {
    margin: 18px 12px 8px;
    color: #a8c0cf;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-bottom: 5px;
    padding: 10px 13px;
    border-radius: var(--radius-small);
    color: #e1edf3;
    font-size: 14px;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.nav-link:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: white;
    text-decoration: none;
}

.nav-link.active {
    background-color: var(--color-primary);
    color: white;
    font-weight: 600;
}

.nav-icon {
    width: 22px;
    text-align: center;
    font-size: 17px;
}

/* 4. Sidebar Footer */

.sidebar-footer {
    padding: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #c1d4df;
    font-size: 12px;
}

/* 5. Main Content Area */

.main-content {
    flex: 1;
    min-width: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* 6. Top Header */

.topbar {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 28px;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-small);
}

.topbar-left,
.topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.topbar-title {
    font-size: 18px;
    font-weight: 600;
}

.topbar-user {
    display: flex;
    align-items: center;
    gap: 10px;
}

.user-avatar {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
}

/* 7. Page Content */

.page-content {
    flex: 1;
    width: 100%;
    padding: 28px;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
}

.page-title {
    margin-bottom: 4px;
}

.page-description {
    color: var(--color-text-secondary);
    font-size: 14px;
}

/* 8. Content Sections */

.content-section {
    margin-bottom: 24px;
}

.content-section-title {
    margin-bottom: 16px;
    font-size: 18px;
}

/* 9. Mobile Menu Button */

.sidebar-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
}

/* 10. Sidebar Overlay */

.sidebar-overlay {
    display: none;
}

/* 11. Tablet Layout */

@media (max-width: 1024px) {
    .sidebar {
        width: 230px;
        min-width: 230px;
    }

    .page-content {
        padding: 22px;
    }

    .topbar {
        padding: 12px 20px;
    }
}

/* 12. Mobile Layout */

@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 260px;
        min-width: 260px;
        height: 100vh;
        transform: translateX(-100%);
    }

    .sidebar-open .sidebar {
        transform: translateX(0);
    }

    .sidebar-toggle {
        display: inline-flex;
    }

    .sidebar-open .sidebar-overlay {
        display: block;
        position: fixed;
        inset: 0;
        z-index: 999;
        background-color: rgba(0, 0, 0, 0.45);
    }

    .topbar {
        min-height: 64px;
        padding: 10px 16px;
    }

    .page-content {
        padding: 18px 14px;
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .topbar-title {
        font-size: 16px;
    }
}

/* 13. Small Mobile Screens */

@media (max-width: 480px) {
    .topbar {
        gap: 8px;
    }

    .topbar-right {
        gap: 8px;
    }

    .page-content {
        padding: 14px 10px;
    }
}
