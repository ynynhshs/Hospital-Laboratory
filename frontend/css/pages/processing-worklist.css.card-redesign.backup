
/* ==========================================
   MEDILINK LABORATORY
   GLASSMORPHISM PROCESSING WORKLIST
========================================== */

/* 1. Development Notice */

.processing-notice {
    align-items: flex-start;
    margin-bottom: 24px;
}

.processing-notice p {
    margin-top: 3px;
}

/* 2. Section Heading */

.processing-section-title {
    margin-bottom: 16px;
    color: var(--color-text);
    font-size: 18px;
}

/* 3. Processing Summary Grid */

.processing-summary-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 15px;
}

.processing-summary-card {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    min-height: 105px;
    padding: 16px;

    border: 1px solid var(--glass-border);
    border-radius: var(--radius-large);
    background: var(--glass-background);
    box-shadow: var(--shadow-small);

    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));

    transition: transform 0.25s ease, border-color 0.25s ease;
}

.processing-summary-card:hover {
    transform: translateY(-3px);
    border-color: var(--glass-highlight);
}

.processing-summary-icon {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    border: 1px solid rgba(139, 146, 255, 0.20);
    border-radius: var(--radius-medium);

    background: rgba(139, 146, 255, 0.13);
    color: var(--color-primary);

    font-size: 21px;
}

/* Processing Status Colors */

.processing-pending {
    border-color: rgba(245, 199, 107, 0.20);
    background: rgba(245, 199, 107, 0.13);
    color: #f5c76b;
}

.processing-active {
    border-color: rgba(116, 189, 255, 0.20);
    background: rgba(116, 189, 255, 0.13);
    color: #83c5ff;
}

.processing-completed {
    border-color: rgba(72, 214, 160, 0.20);
    background: rgba(72, 214, 160, 0.13);
    color: #64e7b5;
}

.processing-hold {
    border-color: rgba(255, 123, 134, 0.20);
    background: rgba(255, 123, 134, 0.13);
    color: #ff8993;
}

.processing-summary-card .summary-value {
    color: var(--color-text);
    font-size: 25px;
}

/* 4. Processing Toolbar */

.processing-toolbar {
    display: grid;

    grid-template-columns:
        minmax(230px, 1.7fr)
        minmax(160px, 1fr)
        minmax(145px, 0.9fr)
        auto;

    align-items: end;
    gap: 14px;
    margin-bottom: 22px;
    padding: 20px;

    border: 1px solid var(--glass-border);
    border-radius: var(--radius-large);

    background: var(--glass-background);
    box-shadow: var(--shadow-small);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

.processing-search,
.processing-filter {
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 7px;
}

.processing-search label,
.processing-filter label {
    color: var(--color-text);
    font-size: 13px;
    font-weight: 600;
}

/* 5. Processing Records Table */

.processing-table-container {
    width: 100%;
    margin-top: 5px;
}

.processing-table-container .data-table {
    min-width: 1250px;
}

.processing-table-container .data-table th,
.processing-table-container .data-table td {
    padding: 14px 13px;
}

/* 6. Processing Table Footer */

.processing-table-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;

    color: var(--color-text-secondary);
    font-size: 12px;
}

/* 7. Processing Action Buttons */

.processing-action-group {
    display: flex;
    align-items: center;
    gap: 7px;
}

.processing-action-button {
    min-height: 30px;
    padding: 5px 9px;

    border: 1px solid var(--glass-border);
    border-radius: var(--radius-small);

    background: var(--glass-background);
    color: var(--color-text);

    font-size: 11px;
    cursor: pointer;

    transition: all 0.2s ease;

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.processing-action-button:hover {
    border-color: var(--color-primary);
    background: var(--glass-background-strong);
}

.processing-action-start {
    border-color: rgba(116, 189, 255, 0.30);
    background: rgba(116, 189, 255, 0.10);
    color: #83c5ff;
}

.processing-action-start:hover {
    border-color: #74bdff;
    background: rgba(116, 189, 255, 0.20);
}

.processing-action-complete {
    border-color: rgba(72, 214, 160, 0.30);
    background: rgba(72, 214, 160, 0.10);
    color: #64e7b5;
}

.processing-action-complete:hover {
    border-color: #48d6a0;
    background: rgba(72, 214, 160, 0.20);
}

/* 8. Processing Page Footer */

.processing-page-footer {
    margin-top: 28px;
    padding: 16px 0;

    border-top: 1px solid var(--color-border);

    color: var(--color-text-secondary);
    font-size: 11px;
    text-align: center;
}

/* 9. Large Screens */

@media (max-width: 1350px) {
    .processing-summary-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .processing-toolbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* 10. Tablet Screens */

@media (max-width: 900px) {
    .processing-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .processing-toolbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* 11. Mobile Screens */

@media (max-width: 768px) {
    .processing-summary-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .processing-summary-card {
        min-height: 90px;
        padding: 16px;
    }

    .processing-toolbar {
        grid-template-columns: 1fr;
        gap: 14px;
        padding: 16px;
    }

    .processing-toolbar .btn {
        width: 100%;
    }

    .processing-table-footer {
        align-items: flex-start;
        flex-direction: column;
    }
}

/* 12. Small Mobile Screens */

@media (max-width: 480px) {
    .processing-summary-card {
        padding: 14px;
    }

    .processing-summary-icon {
        width: 40px;
        height: 40px;
    }

    .processing-summary-card .summary-value {
        font-size: 23px;
    }

    .processing-notice {
        font-size: 12px;
    }
}

/* 13. Reduced Motion Support */

@media (prefers-reduced-motion: reduce) {
    .processing-summary-card,
    .processing-action-button {
        transition: none;
    }
}
