/* =========================================
   AUDIT TRAIL PAGE
   DARK GLASSMORPHISM DESIGN
   ========================================= */

/* 1. Page Header */

.topbar-left {
    display: flex;
    align-items: center;
    gap: 14px;
}

.topbar-subtitle {
    margin-top: 3px;
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 12px;
}

.page-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* 2. Backend Connection Notice */

.audit-notice {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 18px;
    margin-bottom: 24px;
    border: 1px solid rgba(116, 189, 255, 0.22);
    border-radius: var(--radius-medium, 12px);
    background: rgba(64, 139, 204, 0.10);
    color: #d8ecff;
    backdrop-filter: blur(var(--glass-blur, 14px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
}

.notice-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(116, 189, 255, 0.16);
    color: #8bcaff;
    font-size: 17px;
}

.audit-notice strong {
    display: block;
    margin-bottom: 5px;
    color: #eaf5ff;
    font-size: 14px;
}

.audit-notice p {
    color: #a9c6df;
    font-size: 13px;
    line-height: 1.6;
}

/* 3. Audit Summary Cards */

.audit-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 28px;
}

.audit-summary-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-medium, 14px);
    background: var(--glass-background, rgba(255, 255, 255, 0.07));
    box-shadow: var(--shadow-small, 0 8px 24px rgba(0, 0, 0, 0.18));
    backdrop-filter: blur(var(--glass-blur, 14px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
    transition: border-color 0.25s ease,
                background 0.25s ease,
                transform 0.25s ease;
}

.audit-summary-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 146, 255, 0.30);
    background: var(--glass-background-strong, rgba(255, 255, 255, 0.11));
}

.audit-summary-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-size: 21px;
    font-weight: 600;
}

.total-icon {
    color: #8fcaff;
    background: rgba(116, 189, 255, 0.14);
}

.today-icon {
    color: #b7a5ff;
    background: rgba(139, 146, 255, 0.16);
}

.login-icon {
    color: #65e0ad;
    background: rgba(72, 214, 160, 0.14);
}

.security-icon {
    color: #f5cc79;
    background: rgba(245, 199, 107, 0.14);
}

.audit-summary-card > div:last-child {
    min-width: 0;
}

.audit-summary-card p {
    margin-bottom: 9px;
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 12px;
    line-height: 1.5;
}

.audit-summary-card h3 {
    margin-bottom: 5px;
    color: var(--color-text, #f1f5ff);
    font-size: 25px;
    font-weight: 700;
}

.audit-summary-card span {
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 11px;
}

/* 4. Content Sections */

.content-section {
    margin-bottom: 28px;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 17px;
}

.section-heading h3 {
    margin-bottom: 5px;
    color: var(--color-text, #f1f5ff);
    font-size: 17px;
}

.section-heading p {
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 12px;
    line-height: 1.5;
}

/* 5. Audit Filters */

.audit-filter-section {
    padding: 22px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-medium, 14px);
    background: var(--glass-background, rgba(255, 255, 255, 0.07));
    box-shadow: var(--shadow-small, 0 8px 24px rgba(0, 0, 0, 0.18));
    backdrop-filter: blur(var(--glass-blur, 14px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
}

.audit-filter-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: end;
    gap: 16px;
}

.audit-filter-grid .form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}

.audit-filter-grid label {
    color: var(--color-text, #f1f5ff);
    font-size: 12px;
    font-weight: 600;
}

.audit-filter-grid input,
.audit-filter-grid select {
    width: 100%;
    min-width: 0;
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-small, 8px);
    background: rgba(9, 16, 32, 0.58);
    color: var(--color-text, #f1f5ff);
    font-family: inherit;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s ease,
                box-shadow 0.2s ease,
                background 0.2s ease;
}

.audit-filter-grid input::placeholder {
    color: #78869e;
}

.audit-filter-grid select option {
    background: #172139;
    color: #f1f5ff;
}

.audit-filter-grid input:focus,
.audit-filter-grid select:focus {
    border-color: var(--color-primary, #8b92ff);
    background: rgba(12, 20, 39, 0.82);
    box-shadow: 0 0 0 3px rgba(139, 146, 255, 0.14);
}

.audit-filter-grid input[aria-invalid="true"] {
    border-color: var(--color-danger, #ff7b86);
    box-shadow: 0 0 0 3px rgba(255, 123, 134, 0.13);
}

.audit-filter-grid input::-webkit-calendar-picker-indicator {
    cursor: pointer;
    filter: invert(1);
    opacity: 0.75;
}

.audit-filter-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    grid-column: 1 / -1;
    margin-top: 3px;
}

.audit-filter-actions button {
    min-height: 40px;
}

#auditSearchInput {
    min-width: 0;
}

/* Disabled button states */

#exportAuditLogsButton:disabled,
#applyAuditFiltersButton:disabled,
#clearAuditSelectionButton:disabled,
#auditPreviousPageButton:disabled,
#auditNextPageButton:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

/* 6. Audit Table Section */

.audit-table-section {
    padding: 22px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-medium, 14px);
    background: var(--glass-background, rgba(255, 255, 255, 0.07));
    box-shadow: var(--shadow-small, 0 8px 24px rgba(0, 0, 0, 0.18));
    backdrop-filter: blur(var(--glass-blur, 14px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
}

.audit-table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.audit-results-info {
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 12px;
}

.table-responsive {
    width: 100%;
    overflow-x: auto;
    border-radius: var(--radius-small, 8px);
}

#auditLogsTable {
    width: 100%;
    min-width: 1050px;
    border-collapse: collapse;
    text-align: left;
}

#auditLogsTable th,
#auditLogsTable td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.10));
    font-size: 12px;
    vertical-align: middle;
}

#auditLogsTable th {
    background: rgba(255, 255, 255, 0.055);
    color: #aebbd0;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

#auditLogsTable td {
    color: var(--color-text, #e7ecf7);
}

#auditLogsTable tbody tr {
    transition: background 0.2s ease;
}

#auditLogsTable tbody tr:hover {
    background: rgba(139, 146, 255, 0.075);
}

#auditLogsTable tbody tr.selected-row {
    background: rgba(139, 146, 255, 0.15);
    box-shadow: inset 3px 0 0 var(--color-primary, #8b92ff);
}

#auditLogsTable tbody tr:last-child td {
    border-bottom: none;
}

.empty-table-message {
    padding: 35px 15px !important;
    color: var(--color-text-secondary, #a5b1c7) !important;
    text-align: center;
}

/* Audit Outcome Labels */

.audit-outcome {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 65px;
    padding: 5px 9px;
    border: 1px solid transparent;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    text-transform: capitalize;
}

.audit-outcome.success {
    border-color: rgba(72, 214, 160, 0.20);
    background: rgba(72, 214, 160, 0.13);
    color: #70e4b4;
}

.audit-outcome.failed {
    border-color: rgba(255, 123, 134, 0.22);
    background: rgba(255, 123, 134, 0.13);
    color: #ff9ca5;
}

.audit-view-button {
    padding: 6px 10px;
    border: 1px solid rgba(139, 146, 255, 0.24);
    border-radius: var(--radius-small, 8px);
    background: rgba(139, 146, 255, 0.10);
    color: #b9bdff;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease,
                border-color 0.2s ease,
                color 0.2s ease;
}

.audit-view-button:hover {
    border-color: rgba(139, 146, 255, 0.45);
    background: rgba(139, 146, 255, 0.20);
    color: #e0e2ff;
}

/* 7. Pagination */

.audit-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-top: 18px;
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 11px;
}

.pagination-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

.pagination-controls button {
    min-height: 34px;
    padding: 6px 12px;
    font-size: 11px;
}

#auditCurrentPage {
    min-width: 85px;
    text-align: center;
    font-weight: 600;
    color: var(--color-text, #f1f5ff);
}

/* 8. Audit Details Panel */

.audit-details-section {
    padding: 22px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.12));
    border-radius: var(--radius-medium, 14px);
    background: var(--glass-background, rgba(255, 255, 255, 0.07));
    box-shadow: var(--shadow-small, 0 8px 24px rgba(0, 0, 0, 0.18));
    backdrop-filter: blur(var(--glass-blur, 14px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 14px));
}

.audit-details-section[hidden] {
    display: none;
}

.audit-details-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.audit-detail-item {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.10));
    border-radius: var(--radius-small, 8px);
    background: rgba(9, 16, 32, 0.35);
}

.audit-detail-item span {
    color: var(--color-text-secondary, #a5b1c7);
    font-size: 11px;
}

.audit-detail-item strong {
    overflow-wrap: anywhere;
    color: var(--color-text, #f1f5ff);
    font-size: 13px;
    font-weight: 600;
}

.audit-detail-description {
    grid-column: 1 / -1;
}

.audit-detail-description p {
    color: #d5deef;
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

/* 9. Audit Integrity Notice */

.audit-integrity-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 20px;
    padding: 15px;
    border: 1px solid rgba(72, 214, 160, 0.20);
    border-radius: var(--radius-small, 8px);
    background: rgba(72, 214, 160, 0.07);
}

.audit-integrity-note span {
    flex-shrink: 0;
    color: #70e4b4;
    font-size: 18px;
}

.audit-integrity-note p {
    color: #acd9c8;
    font-size: 12px;
    line-height: 1.6;
}

/* 10. Responsive Design - Tablets */

@media (max-width: 1024px) {
    .audit-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .audit-filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .audit-details-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* 11. Responsive Design - Mobile */

@media (max-width: 768px) {
    .page-header-actions {
        width: 100%;
    }

    .page-header-actions button {
        flex: 1;
    }

    .audit-summary-grid {
        gap: 12px;
    }

    .audit-summary-card {
        padding: 15px;
        gap: 10px;
    }

    .audit-summary-icon {
        width: 36px;
        height: 36px;
        font-size: 17px;
    }

    .audit-summary-card h3 {
        font-size: 21px;
    }

    .audit-filter-section,
    .audit-table-section,
    .audit-details-section {
        padding: 16px;
    }

    .audit-filter-grid {
        grid-template-columns: 1fr;
    }

    .audit-filter-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .audit-filter-actions button {
        width: 100%;
    }

    .audit-table-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .audit-table-toolbar button {
        width: 100%;
    }

    .audit-pagination {
        align-items: flex-start;
        flex-direction: column;
    }

    .pagination-controls {
        width: 100%;
        justify-content: space-between;
    }

    .audit-details-grid {
        grid-template-columns: 1fr;
    }

    .audit-detail-description {
        grid-column: auto;
    }
}

/* 12. Small Mobile Screens */

@media (max-width: 420px) {
    .audit-summary-grid {
        grid-template-columns: 1fr;
    }

    .audit-summary-card {
        align-items: center;
    }

    .page-header-actions {
        flex-direction: column;
    }

    .page-header-actions button {
        width: 100%;
    }

    .audit-notice {
        padding: 13px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }
}